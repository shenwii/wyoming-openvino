# ===========================================================================
# Stage 1: Build environment (compile wheels including pyopenjtalk + PyTorch)
# ===========================================================================
FROM docker.io/openvino/ubuntu24_runtime:latest AS builder

USER root

# Install build tools and header files needed for native extensions (e.g. pyopenjtalk)
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake \
    build-essential \
    python3-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY requirements.txt requirements-torch.txt ./
# Compile wheels for full requirements including PyTorch and Kokoro.
# Note: When compiling with PyTorch on Linux, default pip pulls CUDA 12 packages (~11GB).
# To build a CPU-only PyTorch image (~2.5GB), pass --extra-index-url https://download.pytorch.org/whl/cpu
RUN pip wheel --no-cache-dir --wheel-dir=/build/wheels -r requirements-torch.txt

# ===========================================================================
# Stage 2: Clean runtime environment (Full, With PyTorch)
# ===========================================================================
FROM docker.io/openvino/ubuntu24_runtime:latest

USER root

# Install runtime dependencies (espeak-ng phonemizer for Kokoro multilingual)
RUN apt-get update && apt-get install -y --no-install-recommends \
    espeak-ng \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install pre-built wheels from builder stage
COPY --from=builder /build/wheels /wheels
COPY requirements-torch.txt ./requirements.txt
RUN pip install --no-cache-dir --break-system-packages --no-index --find-links=/wheels -r requirements.txt \
    && rm -rf /wheels

# Copy application source code, translations, and entrypoint
COPY i18n.py wyoming-tts.py wyoming-tts.sh ./
COPY lang ./lang
RUN chmod +x wyoming-tts.sh && ln -s /app/wyoming-tts.sh /usr/local/bin/wyoming-tts

EXPOSE 10021

ENTRYPOINT ["/app/wyoming-tts.sh"]
